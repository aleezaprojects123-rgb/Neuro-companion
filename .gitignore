# ================================
# Unity ignore rules
# ================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
Recordings/

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Unity project files generated by IDEs
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
.vs/
.vscode/

# Unity crash reports & logs
sysinfo.txt
*.stackdump
*.log
unity_log.txt
Unity/*.log
Unity/*.png
Unity/NeuroCompanion/*.png
Unity/NeuroCompanion/*.log

# ================================
# Large archives (>100MB)
# ================================
*.zip
*.tar
*.tar.gz
*.7z

# ================================
# Python Backend ignore rules
# ================================
Backend/venv/
Backend/env/
Backend/ENV/
Backend/**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db
.env
